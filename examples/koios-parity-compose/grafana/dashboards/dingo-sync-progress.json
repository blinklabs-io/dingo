{
  "title": "Dingo Preview Sync Progress",
  "uid": "dingo-sync-progress",
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": ["dingo", "preview", "koios-parity"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Chain tip: slot number",
      "description": "cardano_node_metrics_slotNum_int -- the node's current tip slot number. Climbs steadily while syncing from genesis.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cardano_node_metrics_slotNum_int",
          "legendFormat": "tip slot",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Chain tip: block number",
      "description": "cardano_node_metrics_blockNum_int -- the node's current chain height.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cardano_node_metrics_blockNum_int",
          "legendFormat": "block height",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Block apply rate",
      "description": "deriv(cardano_node_metrics_blockNum_int[2m]) -- blocks applied per second, derived from chain-height growth. dingo_ledger_block_pipeline_blocks_validated/_decoded are intentionally not used here: they stay at 0 unless the opt-in block-processing pipeline flags are set, which this stack does not enable.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "deriv(cardano_node_metrics_blockNum_int[2m])",
          "legendFormat": "blocks/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Slots behind wall clock (tip gap)",
      "description": "dingo_tip_gap_slots -- slots between the current wall-clock slot and the chain tip. Trends toward 0 as sync completes and the node reaches the chain tip.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_tip_gap_slots",
          "legendFormat": "tip gap (slots)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Current epoch",
      "description": "cardano_node_metrics_epoch_int",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "cardano_node_metrics_epoch_int",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Chainsync header cache size",
      "description": "dingo_chainsync_seen_headers -- current number of slots retained in the chainsync header deduplication cache; nonzero and moving confirms active chainsync traffic.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_chainsync_seen_headers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Database size on disk",
      "description": "dingo_database_size_bytes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_database_size_bytes",
          "legendFormat": "{{store}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Block stage latency: p50 / p99",
      "description": "histogram_quantile(0.50 or 0.99, sum(rate(dingo_ledger_block_stage_duration_seconds_bucket[$__rate_interval])) by (le, stage)) -- p50 and p99 wall-clock time per ledger-owned processing stage: header_verify, validate, apply, and epoch_rollover (the epoch-boundary transaction, during which no block is applied; blinklabs-io/dingo#4364 measured 25s to 318s). histogram_quantile is an estimate bounded by the bucket edges, which run from 100us to ~419s. epoch_rollover records once per epoch, so its quantile is only defined briefly after a boundary; see Block stage max observed duration for the exact worst case.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(dingo_ledger_block_stage_duration_seconds_bucket[$__rate_interval])) by (le, stage))",
          "legendFormat": "p50 {{stage}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(dingo_ledger_block_stage_duration_seconds_bucket[$__rate_interval])) by (le, stage))",
          "legendFormat": "p99 {{stage}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Block stage max observed duration",
      "description": "dingo_ledger_block_stage_max_duration_seconds -- the exact maximum wall-clock duration observed for each ledger-owned stage (header_verify, validate, apply, epoch_rollover) since process start. Monotonically non-decreasing. Unlike the p50/p99 panel it is not bucket-bounded, so the epoch_rollover series reads the full length of a blinklabs-io/dingo#4364-class boundary stall.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_ledger_block_stage_max_duration_seconds",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    }
  ]
}
