{
  "title": "Dingo Koios Parity",
  "uid": "dingo-koios-parity",
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": ["dingo", "preview", "koios-parity"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current epoch mismatch count",
      "description": "dingo_koiosparity_epoch_mismatch_count -- mismatch row count for the most recently checked epoch, per queue (mirrors check_epoch_status.mismatch_count). The aggregate and account queues check each epoch independently and the account queue can lag, so each has its own value. Zero means that queue's last checked epoch had no mismatch rows.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_koiosparity_epoch_mismatch_count",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last checked epoch",
      "description": "dingo_koiosparity_last_checked_epoch -- most recent epoch the observer has completed a check for. A flat value while the node keeps syncing means the observer has stopped progressing.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_koiosparity_last_checked_epoch",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last FAIL epoch",
      "description": "dingo_koiosparity_last_fail_epoch -- epoch number of the last result with status FAIL. Sticky: does not reset on a later PASS, so a stale, undiagnosed mismatch stays visible.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_koiosparity_last_fail_epoch",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last ERROR epoch",
      "description": "dingo_koiosparity_last_error_epoch -- epoch number of the last result with status ERROR (fetch/check failure, dingo_db_missing past grace, dingo_db_error, or acct_coverage_incomplete). Sticky: does not reset on a later PASS.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "dingo_koiosparity_last_error_epoch",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mismatches by category and severity",
      "description": "increase(dingo_koiosparity_mismatch_total[$__rate_interval]) -- mismatch rows recorded, by category and severity (fail/error/informational). The same FAIL-vs-ERROR-vs-informational triage the check_mismatches table already carries, without querying the cache directly.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "increase(dingo_koiosparity_mismatch_total[$__rate_interval])",
          "legendFormat": "{{queue}}: {{severity}} / {{category}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Epoch results by status",
      "description": "sum by (queue, status) (increase(dingo_koiosparity_epoch_result_total[$__rate_interval])) -- completed epoch validations, by queue and status (pass/fail/error).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue, status) (increase(dingo_koiosparity_epoch_result_total[$__rate_interval]))",
          "legendFormat": "{{queue}}: {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      }
    }
  ]
}
