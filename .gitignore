# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Program binary
/dingo
/bin/dingo
/koios-parity
/node-parity

# Local data directory
/.dingo*
/.devnet
/.tools
/.koios

# node_modules for npm publishing
node_modules/
/npm/vendor/
/npm/checksums.json

# IDEs
.idea/
.vscode/

# Git worktrees
.worktrees/

# Local secrets and operator configuration
.env
*.skey
*.vkey
*.key
*.pem
credentials.json
dingo.yaml

# Tracked fixtures and public verification keys that match the patterns above
!/config/cardano/*/*.vkey
!/internal/test/devnet/.env
!/internal/test/devnet/testdata/*.skey
!/internal/devnetkeys/keys/*
